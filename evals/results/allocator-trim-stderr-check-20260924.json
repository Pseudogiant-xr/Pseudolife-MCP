{
 "title": "Allocator probe runs: container stderr checked for failed workers",
 "date": "2026-09-24",
 "why": "PR #347 review: until 2026-09-24 the threads4 workload joined raw threads, so a worker that raised reached only threading.excepthook and the burst was still measured. This records that no run in the committed artifacts logged a worker failure.",
 "method": "Each run's stderr, as the driver captured it with --log-dir (not committed: the logs embed local host paths), counted for the patterns below; bursts_logged counts the probe's own per-burst (per-trial for pairs) progress lines.",
 "patterns": {
  "exception_in_thread": "Exception in thread",
  "traceback": "Traceback \\(most recent call last\\)",
  "memory_error": "MemoryError|can't allocate memory",
  "killed": "\\bKilled\\b"
 },
