# Opt-in Rust image. Build from the repository root; publication is gated separately.
# Models are provisioned on first start into the persistent model cache.
FROM rust:1.94-bookworm AS builder
WORKDIR /build
COPY rust /build/rust
RUN --mount=type=cache,id=w3j-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=w3j-cargo-target,target=/build/rust/target,sharing=locked \
    cargo build --manifest-path rust/Cargo.toml --locked --release --bin pseudolife-daemon --bin pseudolife-stdio -j 3 \
    && cp rust/target/release/pseudolife-daemon /pseudolife-daemon \
    && cp rust/target/release/pseudolife-stdio /pseudolife-mcp
# PDFium for PDF ingest, installed by the daemon's own provisioner: the pin
# (rust/daemon/pdfium-pin.json) and checks a native install gets. The
# provisioner publishes owner-only (root here); readable by all, so a
# non-root runtime user can load it too.
RUN PSEUDOLIFE_DAEMON_PDFIUM_DIR=/opt/pdfium /pseudolife-daemon provision pdfium \
    && chmod -R a+rX /opt/pdfium

FROM python:3.12-slim-bookworm AS runtime-inputs
# The CPU wheel is used only as a source of its native library, never torch/CUDA.
RUN pip install --no-cache-dir --no-deps onnxruntime==1.27.0 \
    && mkdir /opt/ort \
    && cp /usr/local/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime.so* /opt/ort/ \
    && cp /usr/local/lib/python3.12/site-packages/onnxruntime/capi/libonnxruntime_providers_shared.so /opt/ort/

FROM debian:bookworm-slim
RUN apt-get update && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
USER root
WORKDIR /app
COPY --from=builder /pseudolife-daemon /usr/local/bin/pseudolife-daemon
COPY --from=builder /pseudolife-mcp /usr/local/bin/pseudolife-mcp
COPY --from=runtime-inputs /opt/ort /opt/ort
COPY --from=builder /opt/pdfium /opt/pdfium
COPY plugin/hooks /app/plugin/hooks
COPY --chmod=755 ops/provision-daemon-models.sh /usr/local/bin/provision-daemon-models
# PSEUDOLIFE_DAEMON_ONNX_DIR=<model-root> and PSEUDOLIFE_DAEMON_RERANK_DIR
# remain optional overrides; ordinary startup resolves the pinned cache.
ENV CUDA_VISIBLE_DEVICES=-1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PSEUDOLIFE_MCP_HOST=0.0.0.0 \
    PSEUDOLIFE_MCP_PORT=8765 \
    PSEUDOLIFE_MCP_DATA_DIR=/data \
    PSEUDOLIFE_DAEMON_ORT_THREADS=3 \
    ORT_DYLIB_PATH=/opt/ort/libonnxruntime.so.1.27.0 \
    PSEUDOLIFE_DAEMON_PDFIUM_DIR=/opt/pdfium \
    PSEUDOLIFE_PLUGIN_DIR=/app/plugin
RUN mkdir /data
VOLUME ["/data"]
ARG GIT_SHA=unknown
ARG GIT_DIRTY=unknown
ARG BUILD_TIME=unknown
ARG BUILD_SOURCE=checkout
LABEL org.opencontainers.image.revision=$GIT_SHA \
      org.opencontainers.image.created=$BUILD_TIME \
      pseudolife.build.dirty=$GIT_DIRTY \
      pseudolife.build.source=$BUILD_SOURCE
ENV PSEUDOLIFE_BUILD_GIT_SHA=$GIT_SHA \
    PSEUDOLIFE_BUILD_DIRTY=$GIT_DIRTY \
    PSEUDOLIFE_BUILD_TIME=$BUILD_TIME \
    PSEUDOLIFE_BUILD_SOURCE=$BUILD_SOURCE
EXPOSE 8765
# The check waits for real readiness: up to 30m provisioning plus 90s init.
# Warm init is bounded by the script's 90s marker; later checks take <=3s.
# No successful check or service_healthy dependency precedes actual readiness.
HEALTHCHECK --interval=15s --timeout=32m --start-period=0s --retries=5 \
    CMD ["/usr/local/bin/provision-daemon-models", "--healthcheck"]
ENTRYPOINT ["/usr/local/bin/provision-daemon-models"]
CMD ["pseudolife-daemon"]
