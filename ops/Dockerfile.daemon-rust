# The Rust daemon image, the default Docker engine since 0.23.0. Build from the
# repository root; publication is gated separately.
# Models are provisioned on first start into the persistent model cache.
FROM rust:1.94-bookworm AS builder
WORKDIR /build
COPY rust /build/rust
# Build settings for aws-lc (operating-system seeded random source, #1688).
COPY .cargo /build/.cargo
COPY evals/prompts/assistant_facts_provenance.txt /build/evals/prompts/assistant_facts_provenance.txt
COPY evals/prompts/sonnet_extractor_v5.md /build/evals/prompts/sonnet_extractor_v5.md
RUN --mount=type=cache,id=w3j-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=w3j-cargo-target,target=/build/rust/target,sharing=locked \
    cargo build --manifest-path rust/Cargo.toml --locked --release --bin pseudolife-daemon --bin pseudolife-stdio -j 3 \
    && cp rust/target/release/pseudolife-daemon /pseudolife-daemon \
    && cp rust/target/release/pseudolife-stdio /pseudolife-mcp
# PDFium for PDF ingest, installed by the daemon's own provisioner: the pin
# (rust/daemon/pdfium-pin.json) and checks a native install gets. The
# provisioner publishes owner-only (root here); readable by all, so a
# non-root runtime user can load it too.
RUN PSEUDOLIFE_DAEMON_PDFIUM_DIR=/opt/pdfium /pseudolife-daemon provision pdfium \
    && chmod -R a+rX /opt/pdfium

FROM debian:bookworm-slim AS runtime-inputs
# The ONNX Runtime 1.27.0 CPU wheel from PyPI is used only as a source of its
# native library, never torch/CUDA, and needs no Python: a wheel is a zip.
# Each hash is that wheel's PyPI SHA-256; bump both URLs, both hashes and
# ORT_DYLIB_PATH together. TARGETARCH picks the build platform's wheel, as pip
# did; any other platform stops here with its name.
ARG TARGETARCH
ARG ORT_WHEEL_URL_AMD64=https://files.pythonhosted.org/packages/26/81/24dd9b31b0fb912ee19ca53ac1c9764bfd79d58a2ccef564eb693be831a5/onnxruntime-1.27.0-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl
ARG ORT_WHEEL_SHA256_AMD64=7c65a7438632d55dfbc8a02ee60bd6cf7dd9d1ba05a43d4b851452f32338e194
ARG ORT_WHEEL_URL_ARM64=https://files.pythonhosted.org/packages/84/86/c3b6b17745a1997d784dadc9bd88d713d2e6721139a5a0e885b28cfb79b1/onnxruntime-1.27.0-cp312-cp312-manylinux_2_27_aarch64.manylinux_2_28_aarch64.whl
ARG ORT_WHEEL_SHA256_ARM64=c6fddce0539a4898c7bef35b052ffd37935b2190e35488eab99ce91887743ea1
RUN case "${TARGETARCH:-$(dpkg --print-architecture)}" in \
        amd64) url="$ORT_WHEEL_URL_AMD64" sha="$ORT_WHEEL_SHA256_AMD64" ;; \
        arm64) url="$ORT_WHEEL_URL_ARM64" sha="$ORT_WHEEL_SHA256_ARM64" ;; \
        *) echo "ONNX Runtime: no pinned wheel for ${TARGETARCH:-$(dpkg --print-architecture)}; build for amd64 or arm64" >&2; exit 1 ;; \
    esac \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl unzip \
    && curl -fsSL --retry 3 --retry-delay 5 "$url" -o /tmp/onnxruntime.whl \
    && echo "${sha}  /tmp/onnxruntime.whl" | sha256sum -c - \
    && mkdir /opt/ort \
    && unzip -j /tmp/onnxruntime.whl 'onnxruntime/capi/libonnxruntime.so*' \
        onnxruntime/capi/libonnxruntime_providers_shared.so -d /opt/ort \
    && test -f /opt/ort/libonnxruntime.so.1.27.0 \
    && test -f /opt/ort/libonnxruntime_providers_shared.so \
    && rm -rf /tmp/onnxruntime.whl /var/lib/apt/lists/*

FROM debian:bookworm-slim
RUN apt-get update && apt-get -y upgrade \
    && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
USER root
WORKDIR /app
COPY --from=builder /pseudolife-daemon /usr/local/bin/pseudolife-daemon
COPY --from=builder /pseudolife-mcp /usr/local/bin/pseudolife-mcp
# Offline move/resume compatibility checks read the constant compiled above.
COPY rust/daemon/src/storage/schema_meta.rs /app/pseudolife-schema.rs
COPY --from=runtime-inputs /opt/ort /opt/ort
COPY --from=builder /opt/pdfium /opt/pdfium
COPY plugin/hooks /app/plugin/hooks
COPY frontend/dist /app/static
COPY --chmod=755 ops/provision-daemon-models.sh /usr/local/bin/provision-daemon-models
# PSEUDOLIFE_DAEMON_ONNX_DIR=<model-root> and PSEUDOLIFE_DAEMON_RERANK_DIR
# remain optional overrides; ordinary startup resolves the pinned cache.
ENV PSEUDOLIFE_MCP_HOST=0.0.0.0 \
    PSEUDOLIFE_MCP_PORT=8765 \
    PSEUDOLIFE_MCP_DATA_DIR=/data \
    PSEUDOLIFE_DAEMON_ORT_THREADS=3 \
    ORT_DYLIB_PATH=/opt/ort/libonnxruntime.so.1.27.0 \
    PSEUDOLIFE_DAEMON_PDFIUM_DIR=/opt/pdfium \
    PSEUDOLIFE_PLUGIN_DIR=/app/plugin \
    PSEUDOLIFE_DAEMON_STATIC_DIR=/app/static
# The daemon runs as UID/GID 10001, the Python image's account: new volumes
# take this ownership. Only the entrypoint uses root, to transfer root-owned
# state before it drops root and every capability for good (setpriv, from
# util-linux in the Debian base).
RUN mkdir /data /models && chown 10001:10001 /models /data
VOLUME ["/data"]
ARG GIT_SHA=unknown
ARG GIT_DIRTY=unknown
ARG BUILD_TIME=unknown
ARG BUILD_SOURCE=checkout
LABEL org.opencontainers.image.revision=$GIT_SHA \
      org.opencontainers.image.created=$BUILD_TIME \
      pseudolife.build.dirty=$GIT_DIRTY \
      pseudolife.build.source=$BUILD_SOURCE
ENV PSEUDOLIFE_BUILD_GIT_SHA=$GIT_SHA \
    PSEUDOLIFE_BUILD_DIRTY=$GIT_DIRTY \
    PSEUDOLIFE_BUILD_TIME=$BUILD_TIME \
    PSEUDOLIFE_BUILD_SOURCE=$BUILD_SOURCE
EXPOSE 8765
# The check waits for real readiness: up to 30m provisioning plus 90s init.
# Warm init is bounded by the script's 90s marker; later checks take <=3s.
# No successful check or service_healthy dependency precedes actual readiness.
HEALTHCHECK --interval=15s --timeout=32m --start-period=0s --retries=5 \
    CMD ["/usr/local/bin/provision-daemon-models", "--healthcheck"]
ENTRYPOINT ["/usr/local/bin/provision-daemon-models"]
CMD ["pseudolife-daemon"]
