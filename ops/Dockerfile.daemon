# syntax=docker/dockerfile:1
# Pseudolife-MCP memory daemon — the whole compute side in one image.
#
#   docker compose -f ops/docker-compose.yml up -d --build   # start / rebuild
#
# Self-contained + OS-agnostic: pinned Python, CPU-only torch, and the
# embedding model weights are baked in, so the image runs identically on
# Windows / macOS / Linux with no host Python and no first-run download.
#
# The daemon serves MCP over streamable HTTP at /mcp (and /health). Point
# MCP clients at http://127.0.0.1:8765/mcp — no stdio shim needed.
#
# Build context is the repo ROOT (see docker-compose.yml: context: ..),
# so paths below are relative to the project root.
FROM python:3.12-slim

# HF cache lives at a fixed path so the baked weights resolve at runtime
# under HF_HUB_OFFLINE=1. CPU-only by contract — no CUDA in this image.
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/opt/hf \
    CUDA_VISIBLE_DEVICES=-1 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PSEUDOLIFE_MCP_HOST=0.0.0.0 \
    PSEUDOLIFE_MCP_PORT=8765 \
    PSEUDOLIFE_MCP_DATA_DIR=/data

WORKDIR /app

# 0) Patch base-image OS packages (security: perl / libsqlite3 / ncurses / ...).
#    Content-safe: the bank + state live in the mounted volume, not the image.
RUN apt-get update && apt-get -y upgrade && rm -rf /var/lib/apt/lists/*

# 1) CPU-only torch first, PINNED for reproducibility, from PyTorch's CPU wheel
#    index — the '+cpu' build exists only there; PyPI serves the CUDA build
#    under the same name and version. Pinning (vs >=) makes a rebuild reproduce
#    the validated build instead of drifting.
#
#    Installing it up front is NECESSARY but NOT SUFFICIENT. This step used to
#    claim that a pre-installed torch meant the constrained install below "never
#    pulls the multi-GB CUDA build from PyPI". That was false from 2026-07-24 to
#    2026-07-29: pip reported torch already satisfied, then backtracked off it
#    anyway and shipped 2.13.0+cu130 with ~4 GB of nvidia-*/triton wheels in
#    every image built in that window. A constraint file cannot be negotiated,
#    so when the lock's setuptools pin (83.0.0, via Dependabot) crossed torch
#    2.12.0's own setuptools<82 ceiling, pip resolved the conflict by discarding
#    the pinned torch — not the setuptools pin — and walked forward to a torch
#    with no ceiling. What actually holds torch to the CPU build is the pin in
#    the lockfile applied as a constraint in step 2. Keep both.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    env -u PIP_NO_CACHE_DIR pip install --index-url https://download.pytorch.org/whl/cpu "torch==2.13.0"

# 2) Install the remaining runtime deps, PINNED to the captured lockfile so a
#    rebuild reproduces the known-good set (no silent dependency drift). The
#    lock pins torch==2.13.0+cpu, which the step above already satisfies: the
#    constraint is what stops pip re-resolving it. Because that exact version
#    exists only on the CPU index (not on PyPI), a future dependency that
#    genuinely needs a newer torch fails this build LOUDLY rather than quietly
#    swapping in a CUDA wheel — bump step 1 and the lock together when it does.
#    pypdf floats to latest (the PyPDF2->pypdf security migration). setuptools
#    83.0.0 patches the MANIFEST.in exclusion bypass (Dependabot #6,
#    2026-08-02); torch 2.13.0 has no setuptools ceiling, so the old <82
#    coupling constraint no longer binds. It matches the lock, so the line
#    below is a belt-and-braces no-op.
#
#    This layer intentionally precedes the application-source COPY. A CSS, JS,
#    or Python edit must not invalidate the multi-GB dependency/model layers.
COPY ops/requirements.lock.txt /app/requirements.lock.txt
COPY pyproject.toml /app/
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    env -u PIP_NO_CACHE_DIR python -c "import subprocess,sys,tomllib; \
p=tomllib.load(open('/app/pyproject.toml','rb'))['project']; \
subprocess.check_call([sys.executable,'-m','pip','install','-c','/app/requirements.lock.txt', \
*p['dependencies'],*p['optional-dependencies']['onnx'],'setuptools==83.0.0'])"

# 3) Bake the embedding model(s) into the image so cold start needs no
#    network — kills the HF HEAD-check flakiness and the slow first run.
#    The image sets HF_HUB_OFFLINE=1 for runtime; override to 0 for just this
#    step so the one-time download is allowed at build time.
#
#    Qwen/Qwen3-Embedding-0.6B is EmbeddingConfig's default (schema v25) —
#    MUST be baked or a container from this image boots healthy and then
#    throws OSError under HF_HUB_OFFLINE=1 on the very first tool call
#    (tests/test_release_ux.py pins this bake to the code default so the two
#    can never drift apart again). Torch-only: there is no in-repo ONNX
#    export for this model, so the daemon always runs the torch backend for
#    it (fails soft to torch if 'onnx' is ever requested — see embedding.py).
RUN --mount=type=cache,id=pseudolife-hf,target=/tmp/hf-cache,sharing=locked \
    HF_HOME=/tmp/hf-cache HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 \
    python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('Qwen/Qwen3-Embedding-0.6B'); \
SentenceTransformer('all-MiniLM-L6-v2'); \
SentenceTransformer('all-MiniLM-L6-v2', backend='onnx', model_kwargs={'file_name': 'onnx/model.onnx'})" \
    && mkdir -p /opt/hf/hub \
    && cp -a /tmp/hf-cache/hub/models--Qwen--Qwen3-Embedding-0.6B /opt/hf/hub/ \
    && cp -a /tmp/hf-cache/hub/models--sentence-transformers--all-MiniLM-L6-v2 /opt/hf/hub/ \
    && find /opt/hf -name '*.incomplete' -delete
#    MiniLM stays baked too (both torch and onnx/model.onnx, +90 MB) — tests
#    pin it as the symmetric regression model, and it is the one model that
#    DOES exercise the ONNX backend.

# 4) Application code changes frequently; install it only after the expensive
#    immutable layers above. All declared runtime and ONNX requirements are
#    already installed with lock constraints; do not resolve them again here.
COPY README.md /app/
COPY pseudolife_memory /app/pseudolife_memory
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    env -u PIP_NO_CACHE_DIR pip install --no-deps "/app" && pip check

# Runtime data (neural weights, ChromaDB, cortex snapshot) lives here on a
# mounted volume so it survives container recreation.
RUN mkdir -p /data
VOLUME ["/data"]

EXPOSE 8765

# Liveness: /health is unauthenticated by design (see daemon.py).
HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=5 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=3).status==200 else 1)"

CMD ["python", "-m", "pseudolife_memory.cli", "serve"]
