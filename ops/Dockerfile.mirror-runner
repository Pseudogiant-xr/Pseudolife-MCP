# The forced real-data runner (rust/daemon/harness/mirror/forced.py): the
# differential harnesses with both daemons of one release, on the mirror's
# internal network. The Python oracle runs from the mounted checkout on the
# release image's interpreter, dependencies and embedding cache; the Rust
# daemon is the release's binary with its ONNX Runtime and PDFium.
ARG PYTHON_IMAGE=ghcr.io/pseudogiant-xr/pseudolife-daemon:0.22.1
ARG RUST_IMAGE=pseudolife-daemon-rust:checkout
FROM ${RUST_IMAGE} AS rust

FROM ${PYTHON_IMAGE}
# The release image already carries psycopg, PyYAML, psutil and the MCP SDK.
RUN python -m pip install --no-cache-dir "pytest==9.2.0"
# The oracle's cross-encoder (memory.reranker.model_name's default), baked into
# the release image's HF cache (HF_HOME=/opt/hf) the way ops/Dockerfile.daemon
# bakes the embedding models. The release image carries no cross-encoder and
# the harness runs both daemons with HF_HUB_OFFLINE=1, so without it the
# oracle disables reranking and every rerank case compares that fallback with
# the Rust reranker. The revision is the one rust/daemon/src/model_provision.rs
# pins for the Rust bundle; the id keeps Python's spelling (L-6), because the
# cache folder follows the requested id. A download by commit writes no
# refs/main and Python loads with no revision, so the ref is written here, and
# the offline predict fails the build when the baked model does not load.
ARG RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ARG RERANKER_REVISION=c5ee24cb16019beea0893ab7796b1df96625c6b8
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python -c "import sys; from huggingface_hub import snapshot_download; snapshot_download(sys.argv[1], revision=sys.argv[2], allow_patterns=['config.json', 'model.safetensors', 'special_tokens_map.json', 'tokenizer.json', 'tokenizer_config.json', 'vocab.txt'])" "$RERANKER_MODEL" "$RERANKER_REVISION" \
    && ref="$HF_HOME/hub/models--$(echo "$RERANKER_MODEL" | sed 's#/#--#')/refs" \
    && mkdir -p "$ref" && printf '%s' "$RERANKER_REVISION" > "$ref/main" \
    && python -c "import sys; from sentence_transformers import CrossEncoder; assert len(CrossEncoder(sys.argv[1]).predict([('q', 'c')])) == 1" "$RERANKER_MODEL" \
    && find "$HF_HOME" -name '*.incomplete' -delete
COPY --from=rust /usr/local/bin/pseudolife-daemon /usr/local/bin/pseudolife-daemon
COPY --from=rust /opt/ort /opt/ort
COPY --from=rust /opt/pdfium /opt/pdfium
ENV ORT_DYLIB_PATH=/opt/ort/libonnxruntime.so.1.27.0 \
    PSEUDOLIFE_DAEMON_PDFIUM_DIR=/opt/pdfium \
    PSEUDOLIFE_DAEMON_ORT_THREADS=3 \
    PSEUDOLIFE_EMBEDDING_CPU_DTYPE=fp32 \
    MALLOC_ARENA_MAX=2 \
    PYTHONUNBUFFERED=1
WORKDIR /repo
ENTRYPOINT []
CMD ["python", "rust/daemon/harness/mirror/forced.py", "--help"]
