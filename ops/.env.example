# Machine-local compose settings — copy to ops/.env and uncomment what you
# need. ops/.env is gitignored. Every value here is optional: a missing
# ops/.env runs the stack entirely on defaults.
#
# ops/install.ps1|.sh and ops/update.ps1|.sh pass it explicitly via
# --env-file. The documented bare `docker compose -f ops/docker-compose.yml`
# commands don't have to: compose auto-loads the .env sitting beside the
# compose file it was pointed at (that file's directory is the project
# directory).
#
# WARNING: ops/install.ps1|.sh REWRITE a marked-off managed block in ops/.env
# on every run — everything between
#   # >>> pseudolife-mcp install (managed block ...) >>>
#   # <<< pseudolife-mcp install <<<
# is discarded and regenerated. Hand edits inside those markers are silently
# lost; keep your own overrides above them.

# ── Volumes ───────────────────────────────────────────────────────────────
# Fresh installs create the defaults once (see docker-compose.yml header):
#   docker volume create pseudolife-mcp-bank
#   docker volume create pseudolife-mcp-state
# Installs that predate the volume rename keep their old names instead:
#PSEUDOLIFE_BANK_VOLUME=ops_pseudolife_pgdata
#PSEUDOLIFE_STATE_VOLUME=ops_pseudolife_data

# ── GHCR pull-based install (ops/docker-compose.ghcr.yml overlay only) ─────
# Pin the pulled daemon image to a release tag instead of `latest`. Read by
# the overlay, not the base compose file; updates on the pull path are
# `pull` + `up -d`, never ops/update.ps1.
#PSEUDOLIFE_IMAGE_TAG=latest

# ── Postgres ──────────────────────────────────────────────────────────────
# Loopback-only; set BEFORE the first `up` (the image only applies it when
# initializing a fresh volume — changing it later needs ALTER USER, see the
# docker-compose.yml header).
#POSTGRES_PASSWORD=change-me

# ── Daemon ────────────────────────────────────────────────────────────────
# Timezone for episode titles / timestamps (IANA name).
#TZ=Europe/London
# Hard memory cap for the daemon container (any docker size string, e.g.
# 4g / 6144m). Steady state is ~2.8 GB with the default embedder loaded;
# the shipped default clears that with headroom while fencing a runaway
# allocation (2026-08-04 incident: 21 GB RSS within minutes of boot) to a
# clean container restart instead of a host-wide memory event. The
# memory+swap total is pinned to the same value, so the container gets no
# swap at all (by design). Raise for very large banks. Compose default: 4g.
#PSEUDOLIFE_DAEMON_MEM_LIMIT=4g
# Writer identity stamped on every canonical write (schema v11), and the key
# PSEUDOLIFE_MCP_TIER_MAP matches on. ops/install.ps1|.sh write this into the
# managed block from the client you installed for (claude-code / codex).
#PSEUDOLIFE_WRITER_ID=mcp-client
# Default toolset tier for every session: "minimal" (9 tools: the
# recall/capture loop incl. the set-slot pair + the memory_toolset gate),
# "core" (22: + graph/recall/world/lessons/docs/episodes) or "full" (all 35). This sets per-session
# VISIBILITY, not registration — hidden tools stay callable, and any session
# can step its own tier up or down at runtime via memory_toolset. Compose
# default: core.
#PSEUDOLIFE_MCP_TOOLSET=core
# Per-PRINCIPAL default tiers — "principal:tier" CSV. Principals share the
# writer-id namespace: a named principal from PSEUDOLIFE_MCP_TOKENS below,
# or PSEUDOLIFE_WRITER_ID / the shim's X-PL-Writer for single-token
# installs. E.g. "claude-desktop:minimal,claude-code:core".
# Empty = everyone gets the PSEUDOLIFE_MCP_TOOLSET default.
#PSEUDOLIFE_MCP_TIER_MAP=
# Bearer auth (optional on this loopback-published stack — the 127.0.0.1
# port publish is the boundary). The singular token maps to the reserved
# principal "default" and keeps the PSEUDOLIFE_WRITER_ID writer path.
#PSEUDOLIFE_MCP_TOKEN=
# Per-principal tokens, "token:principal" CSV. A matched token's principal
# BECOMES the writer id (outranks X-PL-Writer) and keys the toolset tier.
# Malformed entries are logged and skipped; a skipped token does not
# authenticate. e.g. "aLongRandomA:claude-desktop,aLongRandomB:hermes"
#PSEUDOLIFE_MCP_TOKENS=

# ── Dream extractor ───────────────────────────────────────────────────────
# Stock default: the in-stack CPU sidecar (http://pseudolife-extractor:8081/v1).
# That default does NOT survive an `ops/install.ps1|.sh -Extractor sonnet-only`
# install, which points the primary at a host-side shim and disables the
# sidecar via ops/docker-compose.override.yml — check the managed block in
# your ops/.env for what is actually in force.
# Point at a bigger model server on the host instead (LM Studio / Ollama /
# llama.cpp / vLLM) — from inside the container the host machine is
# `host.docker.internal`, not `localhost` (resolves on Linux via the
# extra_hosts entry shipped in docker-compose.yml). See docs/guide/dreaming.md
# "Upgrading the extractor".
#PSEUDOLIFE_DREAM_BASE_URL=http://host.docker.internal:1234/v1
#PSEUDOLIFE_DREAM_MODEL=my-model
#PSEUDOLIFE_DREAM_API_KEY=
#PSEUDOLIFE_DREAM_TIMEOUT_SECONDS=480
#PSEUDOLIFE_DREAM_MAX_TOKENS=2048
# Primary/fallback pair: point BASE_URL above at a primary that may be down
# (e.g. a host-side shim) and FALLBACK at the always-on sidecar; mode `auto`
# probes the primary per dream and falls back. The probe needs BOTH fallback
# vars — FALLBACK_BASE_URL *and* FALLBACK_MODEL; with either one unset there
# is no fallback and `auto` is inert.
#PSEUDOLIFE_DREAM_FALLBACK_BASE_URL=http://pseudolife-extractor:8081/v1
#PSEUDOLIFE_DREAM_FALLBACK_MODEL=extractor
#PSEUDOLIFE_DREAM_EXTRACTOR_MODE=auto
# Sidecar idle unload: after this many seconds without a request the in-stack
# llama-server sleeps, freeing the ~7 GB resident model; the next dream call
# transparently reloads it (the request blocks until loaded — well inside
# PSEUDOLIFE_DREAM_TIMEOUT_SECONDS). Set -1 to keep the model always
# resident. Compose default: 300.
#PSEUDOLIFE_EXTRACTOR_SLEEP_IDLE_SECONDS=300
