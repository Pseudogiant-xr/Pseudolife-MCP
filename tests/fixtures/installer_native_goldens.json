      "files": {
        "ops/.env": "# >>> pseudolife-mcp install (managed block — installer rewrites between markers) >>>\nPSEUDOLIFE_INSTALL_INSTRUCTIONS=append;skip\nPSEUDOLIFE_DREAM_BASE_URL=http://u:p@host.docker.internal:9000/v1\nPSEUDOLIFE_DREAM_MODEL=m1\n# <<< pseudolife-mcp install <<<\n"
      },
      "steps": [
        {
          "argv": [
            "state",
            "choices",
            "--env-file",
            "{HOME}/ops/.env"
          ],
          "stdin": null,
          "exit": 1,
          "stdout": "",
          "stderr": "Recorded installer choices are invalid. Repeat the original installer flags to replace the managed block; nothing changed.\n"
        }
      ],
      "note": "Python checks the recorded values in insertion order: INSTRUCTIONS (recorded) before EXTRACTOR_URL (inferred later), so the general refusal wins; alphabetical order would give the credentials one."
