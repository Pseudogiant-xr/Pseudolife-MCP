        {
          "argv": [
            "engine",
            "prepare",
            "--repo",
            "{HOME}/repo",
            "--engine",
            "rust-checkout"
          ],
          "stdin": null,
          "exit": 1,
          "stdout": "",
          "stderr": "This host runs a Rust daemon selected by checkout-mode update, which the installer does not rebuild. Update it with pseudolife-mcp update --checkout {HOME}/repo, or switch it back with pseudolife-mcp update --engine python --checkout {HOME}/repo and rerun the installer. Nothing was started.\n"
        },
        {
          "argv": [
            "engine",
            "choose",
            "--engine",
            "rust"
