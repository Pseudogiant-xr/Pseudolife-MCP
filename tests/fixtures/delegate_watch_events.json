{
  "about": "Pure event classification of pseudolife-mcp delegate-watch: JSON in, exact lines out. tests/test_delegate_watch.py drives pseudolife_memory/delegate_watch_cli.py from this file, and the Rust port's contract tests read the same file. Snapshot maps keep their insertion order, which is the order events are reported in.",
  "checks_state": [
    {"name": "no checks", "rollup": [], "expected": ["none", []]},
    {"name": "no rollup at all", "rollup": null, "expected": ["none", []]},
    {"name": "skipped counts as passed",
     "rollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "SUCCESS"},
                {"__typename": "CheckRun", "name": "b", "status": "COMPLETED", "conclusion": "SKIPPED"}],
     "expected": ["green", []]},
    {"name": "one still running",
     "rollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "SUCCESS"},
                {"__typename": "CheckRun", "name": "b", "status": "IN_PROGRESS", "conclusion": ""}],
     "expected": ["pending", []]},
    {"name": "one failure is enough while others queue",
     "rollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "FAILURE"},
                {"__typename": "CheckRun", "name": "b", "status": "QUEUED", "conclusion": ""}],
     "expected": ["failing", ["a"]]},
    {"name": "a status context in error",
     "rollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "SUCCESS"},
                {"__typename": "StatusContext", "context": "ci/x", "state": "ERROR"}],
     "expected": ["failing", ["ci/x"]]},
    {"name": "a pending status context",
     "rollup": [{"__typename": "StatusContext", "context": "ci/x", "state": "PENDING"}],
     "expected": ["pending", []]},
    {"name": "failed names sorted and unique, cancelled ones left out",
     "rollup": [{"__typename": "CheckRun", "name": "z", "status": "COMPLETED", "conclusion": "TIMED_OUT"},
                {"__typename": "CheckRun", "name": "b", "status": "COMPLETED", "conclusion": "CANCELLED"},
                {"__typename": "CheckRun", "name": "y", "status": "COMPLETED", "conclusion": "STARTUP_FAILURE"},
                {"__typename": "CheckRun", "name": "z", "status": "COMPLETED", "conclusion": "FAILURE"}],
     "expected": ["failing", ["y", "z"]]},
    {"name": "cancelled while others still run is pending",
     "rollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "CANCELLED"},
                {"__typename": "CheckRun", "name": "b", "status": "IN_PROGRESS", "conclusion": ""}],
     "expected": ["pending", []]},
    {"name": "all finished with some cancelled is cancelled, names sorted and unique",
     "rollup": [{"__typename": "CheckRun", "name": "b", "status": "COMPLETED", "conclusion": "CANCELLED"},
                {"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "SUCCESS"},
                {"__typename": "CheckRun", "name": "c", "status": "COMPLETED", "conclusion": "CANCELLED"},
                {"__typename": "CheckRun", "name": "b", "status": "COMPLETED", "conclusion": "CANCELLED"}],
     "expected": ["cancelled", ["b", "c"]]},
    {"name": "a real failure beside cancelled checks is failing",
     "rollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "CANCELLED"},
                {"__typename": "CheckRun", "name": "b", "status": "COMPLETED", "conclusion": "FAILURE"},
                {"__typename": "CheckRun", "name": "c", "status": "QUEUED", "conclusion": ""}],
     "expected": ["failing", ["b"]]}
  ],
  "pr_snapshot": [
    {"name": "fields kept and normalised", "old": null,
     "prs": [{"number": 7, "title": "fix(x): a title well over seventy characters long, which the snapshot cuts short",
              "headRefOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "mergeable": "MERGEABLE",
              "mergeStateStatus": "CLEAN", "isDraft": false,
              "statusCheckRollup": [{"__typename": "CheckRun", "name": "a", "status": "COMPLETED", "conclusion": "SUCCESS"}]}],
     "expected": {"7": {"title": "fix(x): a title well over seventy characters long, which the snapshot ",
                        "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "green", "failed": [],
                        "mergeable": "MERGEABLE", "merge_state": "clean"}}},
    {"name": "UNKNOWN mergeability keeps the last known answer",
     "old": {"2": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                   "mergeable": "CONFLICTING", "merge_state": "dirty"}},
     "prs": [{"number": 2, "title": "t", "headRefOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "mergeable": "UNKNOWN",
              "mergeStateStatus": "UNKNOWN", "isDraft": false, "statusCheckRollup": []}],
     "expected": {"2": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                        "mergeable": "CONFLICTING", "merge_state": "unknown"}}},
    {"name": "UNKNOWN on a new pull request stays UNKNOWN", "old": {},
     "prs": [{"number": 3, "title": "t", "headRefOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "mergeable": "UNKNOWN",
              "mergeStateStatus": null, "isDraft": false, "statusCheckRollup": null}],
     "expected": {"3": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                        "mergeable": "UNKNOWN", "merge_state": "unknown"}}}
  ],
  "pr_events": [
    {"name": "opened", "old": {}, "closed": {},
     "new": {"4": {"title": "feat(x): new thing", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none",
                   "failed": [], "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "expected": ["PR #4 opened: feat(x): new thing"]},
    {"name": "first seen already failing: opened, then its result", "old": {}, "closed": {},
     "new": {"6": {"title": "fix: y", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing",
                   "failed": ["lint"], "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "expected": ["PR #6 opened: fix: y", "PR #6 failing at aaaaaaaa: lint"]},
    {"name": "first seen green and conflicting: opened, green, conflicts", "old": {}, "closed": {},
     "new": {"7": {"title": "fix: z", "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "checks": "green",
                   "failed": [], "mergeable": "CONFLICTING", "merge_state": "dirty"}},
     "expected": ["PR #7 opened: fix: z", "PR #7 green at bbbbbbbb, merge state dirty",
                  "PR #7 conflicts with its base"]},
    {"name": "first seen with checks still running: opened only", "old": {}, "closed": {},
     "new": {"8": {"title": "fix: w", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "pending",
                   "failed": [], "mergeable": "UNKNOWN", "merge_state": "unknown"}},
     "expected": ["PR #8 opened: fix: w"]},
    {"name": "failing",
     "old": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "pending", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "new": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing", "failed": ["lint"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "closed": {}, "expected": ["PR #1 failing at aaaaaaaa: lint"]},
    {"name": "the same failure on the same head is not news again",
     "old": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing", "failed": ["lint", "test"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "new": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing", "failed": ["lint"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "closed": {}, "expected": []},
    {"name": "a further failure on the same head is news, at most four names",
     "old": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing", "failed": ["a"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "new": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing",
                   "failed": ["a", "b", "c", "d", "e"], "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "closed": {}, "expected": ["PR #1 failing at aaaaaaaa: a, b, c, d"]},
    {"name": "cancelled is one line, not a failure",
     "old": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "pending", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "new": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "cancelled",
                   "failed": ["a", "b", "c", "d", "e"], "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "closed": {}, "expected": ["PR #1 cancelled at aaaaaaaa: a, b, c, d"]},
    {"name": "cancelled again on the same head is not news, whatever the names",
     "old": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "cancelled", "failed": ["a"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "new": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "cancelled",
                   "failed": ["a", "b"], "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "closed": {}, "expected": []},
    {"name": "a failure on the same head after it was cancelled is news",
     "old": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "cancelled", "failed": ["a", "b"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "new": {"1": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "failing", "failed": ["a"],
                   "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "closed": {}, "expected": ["PR #1 failing at aaaaaaaa: a"]},
    {"name": "first seen already cancelled: opened, then cancelled", "old": {}, "closed": {},
     "new": {"9": {"title": "fix: v", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "cancelled",
                   "failed": ["lint"], "mergeable": "MERGEABLE", "merge_state": "blocked"}},
     "expected": ["PR #9 opened: fix: v", "PR #9 cancelled at aaaaaaaa: lint"]},
    {"name": "green on a new head",
     "old": {"5": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "green", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "new": {"5": {"title": "t", "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "checks": "green", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "closed": {}, "expected": ["PR #5 green at bbbbbbbb, merge state clean"]},
    {"name": "newly conflicting",
     "old": {"2": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "new": {"2": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                   "mergeable": "CONFLICTING", "merge_state": "dirty"}},
     "closed": {}, "expected": ["PR #2 conflicts with its base"]},
    {"name": "closed and merged, by number, after the open ones",
     "old": {"10": {"title": "ten", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                    "mergeable": "MERGEABLE", "merge_state": "clean"},
             "3": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "new": {"4": {"title": "four", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "closed": {"10": "merged", "3": "closed"},
     "expected": ["PR #4 opened: four", "PR #3 closed: t", "PR #10 merged: ten"]},
    {"name": "missing with no known closure is not reported",
     "old": {"9": {"title": "t", "head": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "checks": "none", "failed": [],
                   "mergeable": "MERGEABLE", "merge_state": "clean"}},
     "new": {}, "closed": {}, "expected": []}
  ],
  "master_snapshot": [
    {"name": "the newest completed run per workflow; an in-progress newer run waits",
     "old": {"CI": {"id": 1, "attempt": 1, "conclusion": "success", "sha": "dddddddddddddddddddddddddddddddddddddddd", "event": "push"}},
     "runs": [{"databaseId": 3, "workflowName": "CI", "status": "in_progress", "conclusion": "",
               "headSha": "ffffffffffffffffffffffffffffffffffffffff", "event": "push"},
              {"databaseId": 2, "workflowName": "CI", "status": "completed", "conclusion": "failure",
               "headSha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "schedule"}],
     "expected": {"CI": {"id": 2, "attempt": null, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "schedule"}}},
    {"name": "a held run being re-run stays as it was; an older run never replaces it",
     "old": {"CI": {"id": 10, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}},
     "runs": [{"databaseId": 10, "attempt": 2, "workflowName": "CI", "status": "in_progress", "conclusion": "",
               "headSha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"},
              {"databaseId": 9, "attempt": 1, "workflowName": "CI", "status": "completed", "conclusion": "success",
               "headSha": "9999999999999999999999999999999999999999", "event": "push"}],
     "expected": {"CI": {"id": 10, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}}},
    {"name": "cancelled runs and pull-request events are skipped",
     "old": {"CI": {"id": 2, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}},
     "runs": [{"databaseId": 5, "workflowName": "CI", "status": "completed", "conclusion": "success",
               "headSha": "1111111111111111111111111111111111111111", "event": "pull_request"},
              {"databaseId": 4, "workflowName": "CI", "status": "completed", "conclusion": "cancelled",
               "headSha": "ffffffffffffffffffffffffffffffffffffffff", "event": "push"}],
     "expected": {"CI": {"id": 2, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}}}
  ],
  "master_events": [
    {"name": "failing after success",
     "old": {"CI": {"id": 1, "attempt": 1, "conclusion": "success", "sha": "dddddddddddddddddddddddddddddddddddddddd", "event": "push"}},
     "new": {"CI": {"id": 2, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "schedule"}},
     "expected": ["master CI failed at eeeeeeee (schedule)"]},
    {"name": "a workflow first seen failing",
     "old": {},
     "new": {"Docs": {"id": 7, "attempt": 1, "conclusion": "timed_out", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}},
     "expected": ["master Docs failed at eeeeeeee (push)"]},
    {"name": "green again after a failure",
     "old": {"CI": {"id": 2, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "schedule"}},
     "new": {"CI": {"id": 5, "attempt": 1, "conclusion": "success", "sha": "9999999999999999999999999999999999999999", "event": "push"}},
     "expected": ["master CI green again at 99999999 (push)"]},
    {"name": "a re-run attempt that passes is a recovery",
     "old": {"CI": {"id": 10, "attempt": 1, "conclusion": "failure", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}},
     "new": {"CI": {"id": 10, "attempt": 2, "conclusion": "success", "sha": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "event": "push"}},
     "expected": ["master CI green again at eeeeeeee (push)"]},
    {"name": "unchanged, and success after success, are quiet",
     "old": {"CI": {"id": 1, "attempt": 1, "conclusion": "success", "sha": "dddddddddddddddddddddddddddddddddddddddd", "event": "push"},
             "Lint": {"id": 4, "attempt": 1, "conclusion": "failure", "sha": "dddddddddddddddddddddddddddddddddddddddd", "event": "push"}},
     "new": {"CI": {"id": 3, "attempt": 1, "conclusion": "success", "sha": "ffffffffffffffffffffffffffffffffffffffff", "event": "push"},
             "Lint": {"id": 4, "attempt": 1, "conclusion": "failure", "sha": "dddddddddddddddddddddddddddddddddddddddd", "event": "push"}},
     "expected": []},
    {"name": "failure after failure is not news",
     "old": {"CI": {"id": 1, "attempt": 1, "conclusion": "failure", "sha": "dddddddddddddddddddddddddddddddddddddddd", "event": "push"}},
     "new": {"CI": {"id": 3, "attempt": 1, "conclusion": "failure", "sha": "ffffffffffffffffffffffffffffffffffffffff", "event": "push"}},
     "expected": []}
  ],
  "suite_events": [
    {"name": "a new result",
     "old": {"old.json": {"machine": "remote", "commit": "cccccccc", "exit": 0, "summary": "18548 passed"}},
     "new": {"old.json": {"machine": "remote", "commit": "cccccccc", "exit": 0, "summary": "18548 passed"},
             "new.json": {"machine": "local-wsl", "commit": "cccccccc", "exit": 1, "summary": "1 failed"}},
     "expected": ["suite local-wsl cccccccc exit 1: 1 failed"]},
    {"name": "nothing new",
     "old": {"old.json": {"machine": "remote", "commit": "cccccccc", "exit": 0, "summary": "ok"}},
     "new": {"old.json": {"machine": "remote", "commit": "cccccccc", "exit": 0, "summary": "ok"}},
     "expected": []}
  ],
  "lease_events": [
    {"name": "held to free",
     "old": {"full-suite": "free", "full-suite@box": "held"},
     "new": {"full-suite": "free", "full-suite@box": "free"},
     "expected": ["full-suite@box free"]},
    {"name": "free is news only after held",
     "old": {}, "new": {"full-suite": "free"}, "expected": []},
    {"name": "taken is not news",
     "old": {"full-suite": "free"}, "new": {"full-suite": "held"}, "expected": []}
  ],
  "quiet_line": [
    {"name": "plural", "minutes": 55,
     "prs": {"1": {"checks": "pending"}, "2": {"checks": "green"}, "3": {"checks": "none"}},
     "expected": "quiet 55m: 3 open PRs, 1 with checks running"},
    {"name": "singular", "minutes": 5, "prs": {"1": {"checks": "green"}},
     "expected": "quiet 5m: 1 open PR, 0 with checks running"},
    {"name": "none", "minutes": 60, "prs": {},
     "expected": "quiet 60m: 0 open PRs, 0 with checks running"}
  ]
}
