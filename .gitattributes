# The Console's sources check out LF on every OS, so a Windows build compiles
# the same bytes as CI's Linux one (text=auto leaves fonts and images alone).
frontend/** text=auto eol=lf

# Keep the vendored offline bundle byte-stable (no EOL normalization). After
# the frontend/** line on purpose: a later matching line wins.
frontend/public/vendor/*.js -text

# The Console's committed build output is stored exactly as Vite writes it
# (LF), so a rebuild on any OS reproduces it byte for byte and CI's
# rebuild-and-diff check sees no line-ending churn.
pseudolife_memory/web/static/** -text

# Shell scripts must check out LF everywhere — bash rejects CRLF.
*.sh text eol=lf

# Unified diffs applied to LF upstream checkouts (evals/taubench_pseudolife/
# patches/) must check out LF too, or `patch -p1` rejects every hunk.
*.patch text eol=lf

# The updater's packaged Compose fallback must match the checkout byte for byte.
ops/docker-compose*.yml text eol=lf
pseudolife_memory/compose/docker-compose*.yml text eol=lf
