{
  "parity": "CLI-RESTORE-GATES",
  "python_roots": [
    "restore_cli",
    "docker_backup_restore"
  ],
  "postgres": false,
  "shim": [
    "backup",
    "backup_help.txt",
    "connect",
    "restore_cli"
  ],
  "source_mutants": [
    "restore-busy-pid-unknown",
    "restore-checkout-unchecked",
    "restore-confirmed-deferred",
    "restore-copy-loose",
    "restore-crc-deferred",
    "restore-data-mount-unchecked",
    "restore-dbname-quoted",
    "restore-desktop-unmapped",
    "restore-directory-skips",
    "restore-dump-after-state",
    "restore-exists-unchecked",
    "restore-explicit-ignored",
    "restore-explicit-values",
    "restore-fifo-allowed",
    "restore-free-floor",
    "restore-free-floor-inclusive",
    "restore-gzip-crc",
    "restore-gzip-padding",
    "restore-health-port-unchecked",
    "restore-help-any-width",
    "restore-host-unmatched-allowed",
    "restore-image-unchecked",
    "restore-inspect-exit",
    "restore-inspect-object-deferred",
    "restore-inspect-stderr",
    "restore-json-error-refused",
    "restore-later-header-error",
    "restore-leave-stopped-ignored",
    "restore-lock-probe-skipped",
    "restore-lone-cr",
    "restore-long-end-quiet",
    "restore-long-keeps-after-nul",
    "restore-long-link-ignored",
    "restore-long-name-ignored",
    "restore-long-short-read-quiet",
    "restore-loop-continues",
    "restore-negative-as-option",
    "restore-no-transient-pass",
    "restore-non-ascii-read",
    "restore-null-device-terminal",
    "restore-octal-prefix",
    "restore-padding-unchecked",
    "restore-pg-running-unchecked",
    "restore-port-range",
    "restore-prefix-ignored",
    "restore-psql-argv",
    "restore-reached-answered",
    "restore-readonly-mount-checked",
    "restore-refusal-exit",
    "restore-refusal-unlocked",
    "restore-required-before-type",
    "restore-service-ignored",
    "restore-signed-checksum",
    "restore-socket-find-exit",
    "restore-socket-payload-ignored",
    "restore-socket-reason",
    "restore-space-order",
    "restore-state-mount-unchecked",
    "restore-state-skipped",
    "restore-storage-location",
    "restore-storage-order",
    "restore-unshared-network-read",
    "restore-unsure-url-read",
    "restore-yes-ignored",
    "restore-zlib-deferred"
  ],
  "platform_exclusions": {
    "linux": {
      "restore-desktop-unmapped": "Declared Windows-only: only Windows maps Docker Desktop's host-mount source paths.",
      "restore-null-device-terminal": "Declared Windows-only: only Windows' CRT isatty() reads the null device as a terminal."
    },
    "windows": {}
  }
}
