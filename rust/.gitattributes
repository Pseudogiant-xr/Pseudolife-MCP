# Help assets the shim's CLI commands embed and translate to platform
# newlines themselves (the wait-mail formatter compares its LF template
# before stream translation). One line per asset or command directory, in
# byte order of the path (`cli/` sorts before `cli_`), so ports adding their
# own touch different lines.
shim/src/cli/backup_help.txt text eol=lf
shim/src/cli/briefing_help.txt text eol=lf
shim/src/cli/conductor_watch/help.txt text eol=lf
shim/src/cli/lease/assets/*.txt text eol=lf
shim/src/cli/restore_cli/*.txt text eol=lf
shim/src/cli/transfer/*.txt text eol=lf
shim/src/cli/wait_mail_help.txt text eol=lf
shim/src/cli_help.txt text eol=lf
# The daemon embeds the Python schema DDL byte for byte (harness/gen_schema_sql.py).
daemon/src/storage/schema.sql text eol=lf
daemon/src/storage/schema_plan.json text eol=lf
daemon/src/storage/schema_meta.rs text eol=lf
# The gate embeds this Python constant byte for byte (harness/record_routes.py).
daemon/harness/goldens/checkin.txt text eol=lf
daemon/harness/goldens/memory-loop-block.txt text eol=lf
daemon/harness/goldens/startup-memory-core.txt text eol=lf
daemon/harness/goldens/onboarding-block.txt text eol=lf
